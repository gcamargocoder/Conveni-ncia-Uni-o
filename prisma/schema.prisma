// Schema do banco (PostgreSQL puro — Railway). A conexão vem da variável DATABASE_URL.
// Nomes de campos seguem o snake_case das colunas para que os serviços
// devolvam exatamente o mesmo formato que a aplicação já consumia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  ativo      Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  produtos Produto[]

  @@map("categorias")
}

model Fornecedor {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String
  razao_social String?
  telefone     String?
  whatsapp     String?
  email        String?
  cnpj_cpf     String?
  endereco     String?
  cidade       String?
  estado       String?
  observacoes  String?
  ativo        Boolean   @default(true)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  produtos Produto[]

  @@map("fornecedores")
}

model Funcionario {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  cargo      String
  pin_hash   String
  ativo      Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  vendas        Venda[]
  movimentacoes MovimentacaoEstoque[]
  recebimentos  Recebimento[]

  caixas_abertos   Caixa[]          @relation("CaixaAbertoPor")
  caixas_fechados  Caixa[]          @relation("CaixaFechadoPor")
  movimentos_caixa MovimentoCaixa[]
  auditoria_caixa  AuditoriaCaixa[]

  @@map("funcionarios")
}

model Cliente {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String
  telefone    String?
  cpf         String?
  endereco    String?
  observacoes String?
  ativo       Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  vendas         Venda[]
  contas_receber ContaReceber[]

  @@map("clientes")
}

model Produto {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  categoria_id   String    @db.Uuid
  fornecedor_id  String?   @db.Uuid
  codigo_barras  String?
  descricao      String?
  preco_venda    Decimal   @db.Decimal(10, 2)
  preco_custo    Decimal   @default(0) @db.Decimal(10, 2)
  estoque_minimo Decimal   @default(0) @db.Decimal(10, 3)
  unidade        String    @default("un")
  ativo          Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)

  categoria     Categoria             @relation(fields: [categoria_id], references: [id])
  fornecedor    Fornecedor?           @relation(fields: [fornecedor_id], references: [id])
  itens_venda   ItemVenda[]
  movimentacoes MovimentacaoEstoque[]

  @@index([categoria_id])
  @@map("produtos")
}

model Venda {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  funcionario_id  String    @db.Uuid
  cliente_id      String?   @db.Uuid
  usuario_id      String?   @db.Uuid // login autenticado que registrou (≠ funcionário do PDV)
  forma_pagamento String
  total           Decimal   @default(0) @db.Decimal(10, 2)
  desconto        Decimal?  @db.Decimal(10, 2)
  valor_recebido  Decimal?  @db.Decimal(10, 2)
  troco           Decimal?  @db.Decimal(10, 2)
  cancelada       Boolean   @default(false)
  dispositivo     String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6) // gravação/recebimento NO SERVIDOR (confiável)
  ocorrido_em     DateTime? @db.Timestamptz(6) // quando a venda aconteceu segundo o dispositivo (validado); null = venda antiga
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  funcionario      Funcionario           @relation(fields: [funcionario_id], references: [id])
  cliente          Cliente?              @relation(fields: [cliente_id], references: [id])
  usuario          Usuario?              @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  itens            ItemVenda[]
  movimentacoes    MovimentacaoEstoque[]
  contas_receber   ContaReceber[]
  movimentos_caixa MovimentoCaixa[]

  @@index([created_at])
  @@index([ocorrido_em])
  @@index([usuario_id])
  @@map("vendas")
}

model ItemVenda {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venda_id       String   @db.Uuid
  produto_id     String   @db.Uuid
  quantidade     Decimal  @db.Decimal(10, 3)
  preco_unitario Decimal  @db.Decimal(10, 2)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  venda   Venda   @relation(fields: [venda_id], references: [id])
  produto Produto @relation(fields: [produto_id], references: [id])

  @@index([venda_id])
  @@map("itens_venda")
}

// Fato histórico: sem updated_at/deleted_at de propósito.
model MovimentacaoEstoque {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produto_id     String   @db.Uuid
  tipo           String
  quantidade     Decimal  @db.Decimal(10, 3)
  funcionario_id String   @db.Uuid
  observacao     String?
  venda_id       String?  @db.Uuid
  dispositivo    String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  produto     Produto     @relation(fields: [produto_id], references: [id])
  funcionario Funcionario @relation(fields: [funcionario_id], references: [id])
  venda       Venda?      @relation(fields: [venda_id], references: [id])

  @@index([produto_id])
  @@index([created_at])
  @@map("movimentacoes_estoque")
}

model ContaReceber {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id     String   @db.Uuid
  venda_id       String   @db.Uuid
  valor_original Decimal  @db.Decimal(10, 2)
  saldo_atual    Decimal  @db.Decimal(10, 2)
  status         String   @default("ABERTA")
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cliente      Cliente       @relation(fields: [cliente_id], references: [id])
  venda        Venda         @relation(fields: [venda_id], references: [id])
  recebimentos Recebimento[]

  @@index([cliente_id])
  @@index([status])
  @@map("contas_receber")
}

model Recebimento {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conta_receber_id String   @db.Uuid
  valor            Decimal  @db.Decimal(10, 2)
  forma_pagamento  String
  observacoes      String?
  funcionario_id   String   @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  conta_receber   ContaReceber    @relation(fields: [conta_receber_id], references: [id])
  funcionario     Funcionario     @relation(fields: [funcionario_id], references: [id])
  movimento_caixa MovimentoCaixa?

  @@index([conta_receber_id])
  @@map("recebimentos")
}

model TentativaPin {
  identificador     String    @id
  tentativas_falhas Int       @default(0)
  bloqueado_ate     DateTime? @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  @@map("tentativas_pin")
}

// =========================================================
// Autenticação de usuários do sistema (login por e-mail + senha).
// Independente de `funcionarios`: o PIN continua sendo a identificação
// do operador de caixa e a autorização de operações sensíveis.
// =========================================================

model Usuario {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique // sempre minúsculo (CHECK no banco)
  nome              String
  senha_hash        String // Argon2id — nunca a senha
  papel             String    @default("operador") // 'admin' | 'operador'
  ativo             Boolean   @default(true)
  senha_alterada_em DateTime? @db.Timestamptz(6)
  ultimo_login_em   DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  sessoes            Sessao[]
  tokens_recuperacao TokenRecuperacao[]
  vendas             Venda[]
  vendas_revisao     VendaRevisao[]     @relation("RevisaoOrigem")
  revisoes_decididas VendaRevisao[]     @relation("RevisaoDecisao")

  caixas_abertos   Caixa[]          @relation("CaixaAbertoUsuario")
  caixas_fechados  Caixa[]          @relation("CaixaFechadoUsuario")
  movimentos_caixa MovimentoCaixa[]
  auditoria_caixa  AuditoriaCaixa[]

  @@map("usuarios")
}

model Sessao {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id         String   @db.Uuid
  token_hash         String   @unique // SHA-256 do token do cookie; o token em si nunca é gravado
  expira_em          DateTime @db.Timestamptz(6) // expiração por inatividade (renovável)
  expira_absoluta_em DateTime @db.Timestamptz(6) // teto, não renovável
  ultimo_uso_em      DateTime @default(now()) @db.Timestamptz(6)
  ip                 String?
  user_agent         String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([expira_em])
  @@map("sessoes")
}

model TokenRecuperacao {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String    @db.Uuid
  token_hash String    @unique // SHA-256 do token enviado por e-mail
  expira_em  DateTime  @db.Timestamptz(6)
  usado_em   DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("tokens_recuperacao")
}

// Pedido pendente de ativação da conta principal (confirmado por link de uso único).
model AtivacaoInicial {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String // minúsculo (CHECK no banco)
  nome       String
  senha_hash String // Argon2id — nunca a senha
  token_hash String    @unique // SHA-256 do token enviado por e-mail
  expira_em  DateTime  @db.Timestamptz(6)
  usado_em   DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@map("ativacoes_iniciais")
}

// Limitador persistente (compartilhado entre instâncias): uma linha por chave
// ("login:conta:<hash>", "login:ip:<ip>", "rec:ip:<ip>", ...).
model LimiteTentativa {
  chave         String    @id
  falhas        Int       @default(0)
  nivel         Int       @default(0) // degrau do bloqueio progressivo
  bloqueado_ate DateTime? @db.Timestamptz(6)
  atualizado_em DateTime  @default(now()) @db.Timestamptz(6)

  @@map("limites_tentativa")
}

// Venda vinda da fila offline que o servidor não aceitou automaticamente.
// "id" é o mesmo da venda local (idempotência). Nunca é apagada pelo sistema.
model VendaRevisao {
  id             String    @id @db.Uuid
  usuario_id     String?   @db.Uuid
  funcionario_id String? // texto: pode ser um valor inválido/forjado, por isso sem FK
  payload        Json
  motivos        Json
  bloqueante     Boolean   @default(false) // true = não pode ser aprovada (payload malformado)
  status         String    @default("pendente") // pendente | aprovada | rejeitada
  decidido_por   String?   @db.Uuid
  decidido_em    DateTime? @db.Timestamptz(6)
  observacao     String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  usuario Usuario? @relation("RevisaoOrigem", fields: [usuario_id], references: [id], onDelete: SetNull)
  decisor Usuario? @relation("RevisaoDecisao", fields: [decidido_por], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("vendas_revisao")
}

// =========================================================
// Controle de caixa. Valores SEMPRE em centavos inteiros.
// O caixa pertence ao TERMINAL (dispositivo), não a um funcionário: vários funcionários
// movimentam o mesmo caixa e cada movimento guarda o funcionário identificado pelo PIN.
// Os ids são gerados no aparelho (UUID) para a sincronização offline ser idempotente.
// =========================================================

model Caixa {
  id                          String    @id @db.Uuid
  terminal_id                 String // identificador do dispositivo (UUID local do navegador)
  terminal_papel              String? // principal | emergencial
  status                      String    @default("aberto") // aberto | fechado
  fundo_inicial_centavos      Int
  observacoes_abertura        String?
  aberto_em                   DateTime  @db.Timestamptz(6) // relógio do terminal
  aberto_por_funcionario_id   String    @db.Uuid
  aberto_por_usuario_id       String?   @db.Uuid
  origem_abertura             String // online | offline
  registrado_em               DateTime  @default(now()) @db.Timestamptz(6)
  fechado_em                  DateTime? @db.Timestamptz(6)
  fechado_por_funcionario_id  String?   @db.Uuid
  fechado_por_usuario_id      String?   @db.Uuid
  origem_fechamento           String?
  conferencia                 Json? // valores contados/informados por forma (centavos)
  resumo_terminal             Json? // resumo calculado no aparelho no fechamento (comparação)
  resumo_fechamento           Json? // resumo oficial, calculado pelo servidor ao fechar
  diferenca_dinheiro_centavos Int?
  diferenca_total_centavos    Int?
  justificativa_divergencia   String?
  conferencia_status          String? // pendente | conferido (revisão do administrador)
  conferido_por_usuario_id    String?   @db.Uuid
  conferido_em                DateTime? @db.Timestamptz(6)
  conferencia_obs             String?
  reaberturas                 Int       @default(0)

  aberto_por_funcionario  Funcionario      @relation("CaixaAbertoPor", fields: [aberto_por_funcionario_id], references: [id])
  fechado_por_funcionario Funcionario?     @relation("CaixaFechadoPor", fields: [fechado_por_funcionario_id], references: [id])
  aberto_por_usuario      Usuario?         @relation("CaixaAbertoUsuario", fields: [aberto_por_usuario_id], references: [id], onDelete: SetNull)
  fechado_por_usuario     Usuario?         @relation("CaixaFechadoUsuario", fields: [fechado_por_usuario_id], references: [id], onDelete: SetNull)
  movimentos              MovimentoCaixa[]
  auditoria               AuditoriaCaixa[]

  @@index([terminal_id, status])
  @@index([aberto_em])
  @@index([status])
  @@map("caixas")
}

// Fato financeiro imutável (trigger bloqueia UPDATE/DELETE). Correção = novo registro de estorno.
model MovimentoCaixa {
  id                   String   @id @db.Uuid
  caixa_id             String   @db.Uuid
  tipo                 String // venda | recebimento_conta | suprimento | outra_entrada | ajuste_entrada | sangria | despesa | outra_saida | ajuste_saida | estorno
  sentido              String // entrada | saida
  forma_pagamento      String // dinheiro | pix | credito | debito | fiado
  valor_centavos       Int
  funcionario_id       String   @db.Uuid // identificado pelo PIN
  usuario_id           String?  @db.Uuid // login administrativo autenticado, quando houver
  dispositivo          String // terminal
  origem               String // online | offline
  origem_operacao      String // pdv | conta_receber | caixa
  venda_id             String?  @db.Uuid
  recebimento_id       String?  @unique @db.Uuid
  estorno_de_id        String?  @unique @db.Uuid
  ordem                Int? // posição do pagamento dentro de uma venda (pagamento dividido)
  descricao            String?
  justificativa        String?
  cartao_bandeira      String?
  cartao_adquirente    String?
  cartao_parcelas      Int?
  cartao_taxa_centavos Int? // taxa CONHECIDA da operadora; nulo = desconhecida (nunca presumida)
  transacao_id         String?
  ocorrido_em          DateTime @db.Timestamptz(6) // relógio do terminal
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  caixa       Caixa           @relation(fields: [caixa_id], references: [id])
  funcionario Funcionario     @relation(fields: [funcionario_id], references: [id])
  usuario     Usuario?        @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  venda       Venda?          @relation(fields: [venda_id], references: [id], onDelete: Restrict)
  recebimento Recebimento?    @relation(fields: [recebimento_id], references: [id], onDelete: Restrict)
  estorno_de  MovimentoCaixa? @relation("EstornoDe", fields: [estorno_de_id], references: [id], onDelete: Restrict)
  estorno     MovimentoCaixa? @relation("EstornoDe")

  @@unique([venda_id, tipo, ordem])
  @@index([caixa_id, ocorrido_em])
  @@index([venda_id])
  @@index([funcionario_id])
  @@map("movimentos_caixa")
}

// Trilha de auditoria do caixa (imutável): abertura, fechamento, reabertura, conferência, conflitos.
model AuditoriaCaixa {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caixa_id       String   @db.Uuid
  acao           String
  funcionario_id String?  @db.Uuid // identificado pelo PIN
  usuario_id     String?  @db.Uuid // administrativo autenticado
  dispositivo    String?
  origem         String? // online | offline
  detalhes       Json?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  caixa       Caixa        @relation(fields: [caixa_id], references: [id])
  funcionario Funcionario? @relation(fields: [funcionario_id], references: [id])
  usuario     Usuario?     @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([caixa_id, created_at])
  @@map("auditoria_caixa")
}

// Operação de caixa vinda do aparelho que o servidor NÃO aceitou automaticamente (ex.: movimento
// para caixa já fechado, abertura em terminal que já tem caixa aberto). Nunca é apagada.
model CaixaConflito {
  id          String    @id @db.Uuid // id da operação local (idempotência)
  tipo        String
  caixa_id    String?
  dispositivo String?
  usuario_id  String?   @db.Uuid
  payload     Json
  motivo      String
  status      String    @default("pendente") // pendente | tratado
  tratado_por String?   @db.Uuid
  tratado_em  DateTime? @db.Timestamptz(6)
  observacao  String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status])
  @@map("caixa_conflitos")
}

// Autorização por PIN, validada NO SERVIDOR, de uma operação administrativa do caixa (sangria, suprimento,
// despesa, ajuste, estorno). O id é o da operação. A sincronização só aplica essas operações se houver
// autorização do mesmo funcionário, permissão, login e escopo (tipo/valor/alvo): o funcionario_id enviado
// pelo aparelho, sozinho, não autoriza nada.
model AutorizacaoCaixa {
  id             String   @id @db.Uuid
  funcionario_id String   @db.Uuid
  usuario_id     String?  @db.Uuid
  permissao      String
  escopo         String
  expira_em      DateTime @db.Timestamptz(6)
  // Preenchido, na MESMA transação que grava a operação, quando a autorização é usada. Uso único.
  consumida_em   DateTime? @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([expira_em])
  @@map("autorizacoes_caixa")
}
