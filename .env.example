# Copie este arquivo para .env.local e preencha. NUNCA versione o .env.local.
# No Railway, estas variáveis são cadastradas na aba "Variables" do serviço
# do app — nada de segredo vai para o repositório.

# --- Banco de dados --------------------------------------------------------
# Conexão com o PostgreSQL (Railway ou local).
# No Railway: adicione o plugin PostgreSQL ao projeto e, no serviço do app,
# crie a variável DATABASE_URL referenciando a do banco: ${{Postgres.DATABASE_URL}}
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="postgresql://postgres:senha@localhost:5432/convenience"

# --- Autenticação / e-mail (ver AUTENTICACAO.md) -----------------------------
# URL pública do sistema, SEM barra final. É a base dos links de recuperação de
# senha enviados por e-mail (nunca é deduzida do cabeçalho Host da requisição).
# Obrigatória em produção. Ex.: https://conveniencia.up.railway.app
APP_URL="http://localhost:3000"

# Envio de e-mail pela API da Resend (https://resend.com) — HTTPS, funciona no
# Railway (que bloqueia SMTP de saída em planos básicos).
# Sem estas duas variáveis a recuperação de senha NÃO envia e-mail (e a tela
# Usuários mostra um aviso). O domínio do remetente precisa estar verificado.
RESEND_API_KEY=""
EMAIL_FROM="Conveniência União <nao-responder@seudominio.com.br>"

# (Opcional) Por quantas horas um aparelho já autenticado pode operar o PDV SEM
# conseguir confirmar a sessão no servidor (modo offline). Padrão: 72.
# NEXT_PUBLIC_SESSAO_OFFLINE_HORAS=72

# --- Ativação inicial da conta principal (/configurar-conta) -----------------
# Código de autorização da configuração inicial (SEGREDO; mínimo 24 caracteres).
# Gere um valor aleatório (ex.: openssl rand -base64 32), cadastre só no Railway e
# entregue ao cliente por canal separado. Sem esta variável o fluxo fica DESLIGADO.
# Depois que a conta principal for ativada, REMOVA a variável.
# ATIVACAO_INICIAL_CODIGO=""

# --- Somente para o script de criação do 1º administrador --------------------
# Use apenas se não houver terminal interativo; APAGUE depois de usar.
# ADMIN_SENHA=""

# --- Somente para os testes de integração (npm run test:integracao) ----------
# Banco DESCARTÁVEL cujo nome termina em _test.
# TEST_DATABASE_URL="postgresql://postgres:senha@localhost:5432/convenience_test"
