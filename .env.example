# Copie este arquivo para .env.local e preencha.
#
# Conexão com o PostgreSQL (Railway ou local).
# No Railway: adicione o plugin PostgreSQL ao projeto e, no serviço do app,
# crie a variável DATABASE_URL referenciando a do banco: ${{Postgres.DATABASE_URL}}
# (a injeção é automática — não precisa copiar o valor).
#
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="postgresql://postgres:senha@localhost:5432/convenience"
