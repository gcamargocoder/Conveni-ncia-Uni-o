# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Painel do Supabase -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# ATENÇÃO — SUPABASE_SERVICE_ROLE_KEY é SECRETA.
# NUNCA prefixe com NEXT_PUBLIC_ (isso a exporia no navegador).
# NUNCA coloque em repositório público (.gitignore já cobre .env.local).
# Com ela, o servidor ignora RLS — por isso só o backend (Server
# Actions/Server Components) deve usá-la, nunca o navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Sem essas variáveis preenchidas, o app não consegue falar com o banco.
# Se ainda não tem um projeto Supabase: supabase.com -> New Project (gratuito para começar).
